# 运行期产物：数据库、原文快照、tongstock 缓存
data/*
!data/theme_alias.csv
!data/theme_business.csv
data/snapshots/
data/cache/
*.db

# 日报：Markdown / HTML 入库作为交付物与证据；
# JSON 是本机产物（快照字段保留绝对路径），不入库
reports/*.json

# 人工 inbound 目录：只保留目录骨架（.gitkeep），用户放进去的原稿不入库
inbound/*/*
!inbound/*/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store
.env
