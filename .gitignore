# 运行期产物：数据库、原文快照、tongstock 缓存
data/*
!data/theme_alias.csv
!data/theme_business.csv
data/snapshots/
data/cache/
*.db

# 日报产物：Markdown / HTML / JSON 均为本机交付物，不入库
reports/

# 人工 inbound 目录：只保留目录骨架（.gitkeep），用户放进去的原稿不入库
inbound/*/*
!inbound/*/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/
.DS_Store
.env
.freebuff
